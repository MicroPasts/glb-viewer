{
  "name": "@micropasts/glb-model-viewer",
  "version": "1.0.22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micropasts/glb-viewer.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Lightweight, high-precision Three.js GLB/glTF 3D artifact & model viewer for React with calibrated measurements, cross-section slicing, and mesh exports.",
  "type": "module",
  "main": "./dist/glb-model-viewer.js",
  "module": "./dist/glb-model-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glb-model-viewer.js"
    },
    "./style.css": "./dist/glb-model-viewer.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/tailwind.test.js && vitest run && npm run test:types",
    "test:types": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --target es2022 --jsx react-jsx tests/types.fixture.tsx",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm run build",
    "build:pages": "vite build --mode pages"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.163.0"
  },
  "dependencies": {
    "three-mesh-bvh": "^0.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  },
  "keywords": [
    "threejs",
    "glb",
    "gltf",
    "3d-viewer",
    "react",
    "archaeology",
    "photogrammetry",
    "measurement",
    "stl-export"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
