{
  "name": "@micropasts/glb-model-viewer",
  "version": "1.0.2",
  "description": "Lightweight, high-precision Three.js GLB/glTF 3D artifact & model viewer for React with calibrated measurements, cross-section slicing, and mesh exports.",
  "type": "module",
  "main": "./dist/glb-model-viewer.js",
  "module": "./dist/glb-model-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glb-model-viewer.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/index.d.ts dist/index.d.ts",
    "prepublishOnly": "npm run build",
    "build:pages": "vite build --mode pages"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": ">=0.155.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.16",
    "three": "^0.170.0",
    "vite": "^6.0.0"
  },
  "keywords": [
    "threejs",
    "glb",
    "gltf",
    "3d-viewer",
    "react",
    "archaeology",
    "photogrammetry",
    "measurement",
    "stl-export"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
